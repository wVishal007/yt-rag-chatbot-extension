{
  "manifest_version": 3,
  "name": "YouTube RAG Assistant",
  "version": "1.0",
  "description": "Chat with any YouTube video using RAG.",
  "permissions": ["activeTab", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.jpeg"
  },
  "host_permissions": ["http://localhost:3001/*"]
}

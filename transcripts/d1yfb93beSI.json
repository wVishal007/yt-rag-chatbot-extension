[{"text": "Tell me about yourself.", "start": 4.335, "duration": 1.501, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=4"}, {"text": "Four simple words that can make anyone ramble or freeze.", "start": 6.837, "duration": 4.672, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=6"}, {"text": "Even people at the top of their game can go blank", "start": 11.542, "duration": 2.636, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=11"}, {"text": "when they hear those dreaded words.", "start": 14.211, "duration": 2.403, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=14"}, {"text": "So what does that mean?", "start": 16.647, "duration": 2.236, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=16"}, {"text": "Does your introduction really make that big of a difference?", "start": 19.25, "duration": 3.603, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=19"}, {"text": "I never thought it did.", "start": 23.587, "duration": 1.502, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=23"}, {"text": "I thought my introduction wasn't nearly as important as my qualifications.", "start": 25.122, "duration": 4.705, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=25"}, {"text": "For example, right after I started my business,", "start": 30.361, "duration": 2.803, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=30"}, {"text": "I had the perfect opportunity to shine.", "start": 33.197, "duration": 3.07, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=33"}, {"text": "I was interviewing as an instructor for Supply Chain Institute,", "start": 36.3, "duration": 3.637, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=36"}, {"text": "and I knew I was the ideal candidate.", "start": 39.937, "duration": 3.07, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=39"}, {"text": "I had over 20 years of expertise leading supply chains", "start": 43.407, "duration": 3.437, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=43"}, {"text": "for one of the world's largest consumer products companies.", "start": 46.844, "duration": 3.136, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=46"}, {"text": "As a prep for my interview,", "start": 50.648, "duration": 1.902, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=50"}, {"text": "I didn't want there to be any doubts about my qualifications.", "start": 52.583, "duration": 4.037, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=52"}, {"text": "I created an elevator pitch", "start": 56.654, "duration": 2.169, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=56"}, {"text": "and included a complete list of my accomplishments.", "start": 58.856, "duration": 3.67, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=58"}, {"text": "When I heard \"Tell me about yourself,\"", "start": 62.526, "duration": 2.903, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=62"}, {"text": "I was ready, and I proudly explained everything that I could do.", "start": 65.463, "duration": 5.305, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=65"}, {"text": "When I finished, the interviewer said,", "start": 71.302, "duration": 4.604, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=71"}, {"text": "\"Instead of talking about yourself,", "start": 75.94, "duration": 2.936, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=75"}, {"text": "it would have been more effective", "start": 78.909, "duration": 2.136, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=78"}, {"text": "if you had explained what you can do for me.\"", "start": 81.078, "duration": 3.437, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=81"}, {"text": "My interview lasted five minutes.", "start": 86.617, "duration": 3.804, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=86"}, {"text": "She rejected me on the spot based off of one answer.", "start": 91.021, "duration": 4.338, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=91"}, {"text": "That was my wake-up call.", "start": 96.427, "duration": 2.736, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=96"}, {"text": "I realized it doesn't matter how smart you are,", "start": 99.163, "duration": 3.203, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=99"}, {"text": "it doesn't matter how perfect a fit you are,", "start": 102.399, "duration": 2.77, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=102"}, {"text": "if you can't capture someone's attention.", "start": 105.169, "duration": 2.836, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=105"}, {"text": "After that, I became laser-focused", "start": 109.073, "duration": 2.803, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=109"}, {"text": "on cracking the code on introducing myself.", "start": 111.909, "duration": 2.703, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=111"}, {"text": "I studied the science of first impressions.", "start": 114.645, "duration": 2.936, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=114"}, {"text": "I researched viral headlines and what made them so irresistible.", "start": 117.615, "duration": 4.571, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=117"}, {"text": "And then, I discovered the secret", "start": 122.653, "duration": 2.536, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=122"}, {"text": "of introducing myself perfectly in 20 words or less.", "start": 125.222, "duration": 4.138, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=125"}, {"text": "Fast-forward about six months.", "start": 130.427, "duration": 3.07, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=130"}, {"text": "I'm having coffee with the executive director", "start": 133.531, "duration": 2.335, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=133"}, {"text": "of a business-development program.", "start": 135.866, "duration": 1.869, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=135"}, {"text": "She asks me, \"What do you do?\"", "start": 137.768, "duration": 2.936, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=137"}, {"text": "I answer her in one sentence:", "start": 141.372, "duration": 2.602, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=141"}, {"text": "\"I'm a communications consultant", "start": 145.209, "duration": 1.902, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=145"}, {"text": "and I help people with something to say but struggle to say it.\"", "start": 147.111, "duration": 4.171, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=147"}, {"text": "She leans in and says three magic words.", "start": 152.383, "duration": 4.971, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=152"}, {"text": "\"Tell me more.\"", "start": 158.822, "duration": 2.036, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=158"}, {"text": "Fifteen minutes later,", "start": 160.858, "duration": 1.368, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=160"}, {"text": "she hires me to give workshops for new entrepreneurs.", "start": 162.259, "duration": 2.97, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=162"}, {"text": "But here's the thing.", "start": 165.629, "duration": 2.436, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=165"}, {"text": "I was the same person who blew that interview just six months before.", "start": 168.465, "duration": 4.705, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=168"}, {"text": "But this time, I got the job,", "start": 173.771, "duration": 3.103, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=173"}, {"text": "even though I had way fewer qualifications", "start": 176.907, "duration": 3.837, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=176"}, {"text": "and the only thing different between success and failure,", "start": 180.778, "duration": 3.837, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=180"}, {"text": "between that door of opportunity opening or slamming shut in my face,", "start": 184.648, "duration": 5.172, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=184"}, {"text": "was my introduction.", "start": 189.853, "duration": 1.335, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=189"}, {"text": "From that point on, I started to see my introduction in a whole new light.", "start": 192.389, "duration": 4.905, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=192"}, {"text": "It wasn't just a way of grabbing someone's attention.", "start": 197.728, "duration": 3.136, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=197"}, {"text": "I thought about all those times when I would hear \"no,\"", "start": 201.865, "duration": 5.539, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=201"}, {"text": "and my inner critic would tell me that people didn't see me or hear me", "start": 207.438, "duration": 5.138, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=207"}, {"text": "because I wasn't good enough or smart enough.", "start": 212.61, "duration": 3.37, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=212"}, {"text": "But that was wrong. It wasn't me.", "start": 216.981, "duration": 3.27, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=216"}, {"text": "It was my introduction.", "start": 220.751, "duration": 2.236, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=220"}, {"text": "Alright, are you ready to introduce yourself in 20 words or less?", "start": 224.421, "duration": 4.405, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=224"}, {"text": "I'm going to start with two secrets of getting people to say \"tell me more.\"", "start": 230.628, "duration": 5.038, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=230"}, {"text": "Secret number one:", "start": 236.7, "duration": 1.635, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=236"}, {"text": "Think sound bite, not data dump.", "start": 239.903, "duration": 4.171, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=239"}, {"text": "That\u2019s because with today\u2019s", "start": 244.108, "duration": 1.301, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=244"}, {"text": "multitasking attention-deficit audiences,", "start": 245.409, "duration": 3.637, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=245"}, {"text": "it's been said you have a better chance", "start": 249.079, "duration": 2.403, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=249"}, {"text": "of engaging with a goldfish than the person that you\u2019re talking to.", "start": 251.482, "duration": 5.639, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=251"}, {"text": "A 20-word introduction is designed to grab someone\u2019s attention", "start": 257.154, "duration": 3.604, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=257"}, {"text": "and get them to say \"tell me more.\"", "start": 260.791, "duration": 2.936, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=260"}, {"text": "Secret number two.", "start": 264.862, "duration": 2.035, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=264"}, {"text": "Do you remember what that interviewer told me?", "start": 267.331, "duration": 2.736, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=267"}, {"text": "\"Don't talk about yourself.\"", "start": 271.769, "duration": 2.869, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=271"}, {"text": "Instead, explain what you can do for them.", "start": 274.972, "duration": 3.503, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=274"}, {"text": "I call it the difference between", "start": 279.109, "duration": 1.535, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=279"}, {"text": "an \u201cabout-me\u201d versus an \u201cabout-you\u201d introduction.", "start": 280.644, "duration": 4.371, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=280"}, {"text": "An about-me introduction sounds like this:", "start": 285.949, "duration": 3.337, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=285"}, {"text": "\"I'm an award-winning, best-selling author.\"", "start": 289.32, "duration": 2.902, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=289"}, {"text": "Compare that to \"I help new authors get published faster.\"", "start": 293.357, "duration": 5.205, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=293"}, {"text": "Can you hear the difference?", "start": 298.595, "duration": 2.236, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=298"}, {"text": "One describes me, the other describes what I can do for you.", "start": 300.831, "duration": 5.372, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=300"}, {"text": "Now that you know the secrets,", "start": 307.938, "duration": 1.668, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=307"}, {"text": "here are five ways to introduce yourself perfectly in 20 words or less.", "start": 309.64, "duration": 4.738, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=309"}, {"text": "I'm going to start", "start": 315.779, "duration": 1.201, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=315"}, {"text": "with a straightforward about-you introduction.", "start": 316.98, "duration": 3.237, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=316"}, {"text": "The formula is \"I help my target audience achieve", "start": 320.25, "duration": 3.437, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=320"}, {"text": "a benefit they desire.\"", "start": 323.721, "duration": 2.002, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=323"}, {"text": "For example,", "start": 326.19, "duration": 1.434, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=326"}, {"text": "\"I help worried job hunters confidently explain", "start": 327.658, "duration": 3.236, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=327"}, {"text": "why they're the ideal candidate to hire.\"", "start": 330.928, "duration": 2.369, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=330"}, {"text": "Now, here's a tip about your \"benefit.\"", "start": 334.264, "duration": 3.771, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=334"}, {"text": "A benefit answers your listeners' question", "start": 338.068, "duration": 3.637, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=338"}, {"text": "\"How will my life be different?\"", "start": 341.739, "duration": 2.135, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=341"}, {"text": "For the second framework, let's go beyond offering a benefit.", "start": 345.042, "duration": 4.871, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=345"}, {"text": "Let's promise a breakthrough.", "start": 349.947, "duration": 2.736, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=349"}, {"text": "The formula is the same as the benefit one,", "start": 353.851, "duration": 2.702, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=353"}, {"text": "but you're going to add the word \"without.\"", "start": 356.587, "duration": 3.303, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=356"}, {"text": "\"I help my target audience achieve a benefit they desire", "start": 359.89, "duration": 4.371, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=359"}, {"text": "without negative consequence.\"", "start": 364.294, "duration": 2.703, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=364"}, {"text": "\"I help establish brands in competitive markets,", "start": 368.665, "duration": 3.07, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=368"}, {"text": "rapidly reach new audiences without increasing marketing spend.\"", "start": 371.735, "duration": 5.839, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=371"}, {"text": "The word \"without\" is so powerful", "start": 378.375, "duration": 3.037, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=378"}, {"text": "because that's how you explain what makes you unique.", "start": 381.445, "duration": 3.937, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=381"}, {"text": "For the last three frameworks,", "start": 387.317, "duration": 1.469, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=387"}, {"text": "here's what to say if you don't want to focus on your career.", "start": 388.819, "duration": 4.538, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=388"}, {"text": "For example, you're mission-driven, or you're on a career pivot.", "start": 393.39, "duration": 5.239, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=393"}, {"text": "Maybe you're a student", "start": 398.662, "duration": 1.735, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=398"}, {"text": "and you don't have a lot of work experience.", "start": 400.431, "duration": 2.635, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=400"}, {"text": "In this case, you can use your passion, your mission or your strength.", "start": 403.1, "duration": 5.706, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=403"}, {"text": "I'll start with your passion.", "start": 410.274, "duration": 1.768, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=410"}, {"text": "\"I'm passionate about something I value", "start": 413.143, "duration": 2.469, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=413"}, {"text": "to achieve something my target audience values.\"", "start": 415.646, "duration": 3.27, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=415"}, {"text": "\"I'm passionate about helping people in need", "start": 420.05, "duration": 2.97, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=420"}, {"text": "and creating opportunities that change lives.\"", "start": 423.02, "duration": 3.603, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=423"}, {"text": "Next, instead of your passion, you can use your strength.", "start": 427.858, "duration": 4.404, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=427"}, {"text": "\"I'm known for my strength to achieve something", "start": 434.031, "duration": 3.136, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=434"}, {"text": "my target audience values.\"", "start": 437.201, "duration": 1.835, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=437"}, {"text": "\"I'm known for my critical thinking", "start": 440.537, "duration": 2.269, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=440"}, {"text": "and turning information into actionable insights.\"", "start": 442.84, "duration": 3.67, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=442"}, {"text": "Last, you can use your mission.", "start": 447.744, "duration": 3.37, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=447"}, {"text": "\u201cI\u2019m on a mission to -- to achieve something my target audience values.\u201d", "start": 453.05, "duration": 5.005, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=453"}, {"text": "\"I'm on a mission to bridge the healthcare divide", "start": 459.59, "duration": 3.136, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=459"}, {"text": "and make a lasting difference for vulnerable communities.\"", "start": 462.759, "duration": 4.305, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=462"}, {"text": "And that's how you use your passion, your mission or your strength.", "start": 467.097, "duration": 4.905, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=467"}, {"text": "Now that you've seen the five introductions,", "start": 473.437, "duration": 2.436, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=473"}, {"text": "your next step -- try them out.", "start": 475.906, "duration": 2.536, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=475"}, {"text": "Don't be surprised if you find yourself using more than one.", "start": 479.443, "duration": 3.003, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=479"}, {"text": "That's because different audiences value different things,", "start": 482.479, "duration": 4.738, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=482"}, {"text": "so what works for one may not work for another.", "start": 487.251, "duration": 4.337, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=487"}, {"text": "But that's OK.", "start": 491.588, "duration": 1.602, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=491"}, {"text": "You'll see there are multiple ways of getting people to say \"tell me more.\"", "start": 493.19, "duration": 6.573, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=493"}, {"text": "I'll close with this thought:", "start": 502.733, "duration": 1.601, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=502"}, {"text": "Have doors been closed in your face?", "start": 505.936, "duration": 2.869, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=505"}, {"text": "Do you struggle to be seen and heard?", "start": 509.973, "duration": 2.836, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=509"}, {"text": "Does your inner critic tell you you're not good enough or smart enough,", "start": 513.844, "duration": 5.405, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=513"}, {"text": "or that you're an imposter and something is way above your pay grade?", "start": 519.283, "duration": 4.804, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=519"}, {"text": "Before you buy into your inner critic's narrative, let me challenge you.", "start": 525.522, "duration": 4.605, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=525"}, {"text": "What if?", "start": 530.961, "duration": 2.135, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=530"}, {"text": "What if that voice inside your head is wrong?", "start": 533.83, "duration": 3.571, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=533"}, {"text": "What if you are good enough and smart enough?", "start": 538.302, "duration": 3.403, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=538"}, {"text": "What if the best way to describe you is \"impressive\"?", "start": 542.306, "duration": 3.536, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=542"}, {"text": "Not \"imposter.\"", "start": 546.343, "duration": 2.202, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=546"}, {"text": "And what if the only thing between you and being seen,", "start": 549.646, "duration": 6.874, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=549"}, {"text": "heard and recognized", "start": 556.553, "duration": 2.636, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=556"}, {"text": "is your introduction", "start": 559.189, "duration": 2.136, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=559"}, {"text": "in 20 words.", "start": 561.325, "duration": 2.102, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=561"}, {"text": "", "start": 564.061, "duration": 4.804, "video_id": "d1yfb93beSI", "url": "https://youtube.com/watch?v=d1yfb93beSI&t=564"}]
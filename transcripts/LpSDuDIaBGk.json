[{"text": "So a couple of years ago,", "start": 4.292, "duration": 1.71, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=4"}, {"text": "a woman I know who I'll call Maya,", "start": 6.044, "duration": 2.961, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=6"}, {"text": "went through a lot of big changes in a short amount of time.", "start": 9.047, "duration": 3.128, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=9"}, {"text": "She got married.", "start": 12.217, "duration": 1.168, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=12"}, {"text": "She and her husband moved for his job to a new city", "start": 13.426, "duration": 2.67, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=13"}, {"text": "where she didn\u2019t know anyone.", "start": 16.096, "duration": 1.668, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=16"}, {"text": "She started a new role working from home,", "start": 17.806, "duration": 2.586, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=17"}, {"text": "all while managing her dad's new diagnosis of dementia.", "start": 20.433, "duration": 3.546, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=20"}, {"text": "And to manage the stress of all this change,", "start": 24.688, "duration": 2.878, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=24"}, {"text": "Maya doubled down on her physical and mental health.", "start": 27.607, "duration": 3.337, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=27"}, {"text": "She exercised almost every day,", "start": 30.986, "duration": 1.793, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=30"}, {"text": "she ate healthy foods,", "start": 32.821, "duration": 1.376, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=32"}, {"text": "she went to therapy once a week.", "start": 34.239, "duration": 1.752, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=34"}, {"text": "And these actions really helped.", "start": 36.324, "duration": 1.627, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=36"}, {"text": "Her body got stronger.", "start": 37.993, "duration": 1.668, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=37"}, {"text": "Her mind got more resilient, but only up to a point.", "start": 39.703, "duration": 3.837, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=39"}, {"text": "She was still struggling,", "start": 44.332, "duration": 1.543, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=44"}, {"text": "often losing sleep in the middle of the night,", "start": 45.875, "duration": 2.92, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=45"}, {"text": "feeling unfocused, unmotivated during the day.", "start": 48.795, "duration": 2.461, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=48"}, {"text": "Maya was doing everything that doctors typically tell us to do", "start": 51.298, "duration": 3.753, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=51"}, {"text": "to be physically and mentally healthy,", "start": 55.051, "duration": 2.67, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=55"}, {"text": "and yet something was missing.", "start": 57.762, "duration": 1.919, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=57"}, {"text": "What if I told you that what was missing for Maya", "start": 61.057, "duration": 2.878, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=61"}, {"text": "is also missing for billions of people around the world,", "start": 63.977, "duration": 3.962, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=63"}, {"text": "and that it might be missing for you?", "start": 67.939, "duration": 1.919, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=67"}, {"text": "What if I told you that not having it undermines our other efforts", "start": 70.859, "duration": 4.004, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=70"}, {"text": "to be healthy and can even shorten your lifespan?", "start": 74.904, "duration": 3.379, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=74"}, {"text": "I\u2019ve been studying this for over a decade,", "start": 79.951, "duration": 2.211, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=79"}, {"text": "and I've discovered that the traditional way we think", "start": 82.203, "duration": 3.003, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=82"}, {"text": "about health is incomplete.", "start": 85.248, "duration": 2.711, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=85"}, {"text": "By thinking of our health as primarily physical and mental,", "start": 88.46, "duration": 3.753, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=88"}, {"text": "we overlook what I believe is the greatest challenge", "start": 92.255, "duration": 3.545, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=92"}, {"text": "and the greatest opportunity of our time.", "start": 95.842, "duration": 2.795, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=95"}, {"text": "Social health.", "start": 99.304, "duration": 1.668, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=99"}, {"text": "While physical health is about our bodies", "start": 101.681, "duration": 2.586, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=101"}, {"text": "and mental health is about our minds,", "start": 104.309, "duration": 2.127, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=104"}, {"text": "social health is about our relationships.", "start": 106.478, "duration": 3.712, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=106"}, {"text": "And if you haven't heard this term before,", "start": 110.649, "duration": 2.043, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=110"}, {"text": "that's because it hasn't yet made its way into mainstream vocabulary,", "start": 112.692, "duration": 4.004, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=112"}, {"text": "yet it is equally important.", "start": 116.738, "duration": 2.586, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=116"}, {"text": "Maya didn't yet have a sense of community in her new home.", "start": 120.158, "duration": 3.295, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=120"}, {"text": "She wasn't seeing her family,", "start": 123.453, "duration": 1.752, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=123"}, {"text": "or her friends or her coworkers in person anymore,", "start": 125.246, "duration": 3.045, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=125"}, {"text": "and she often went weeks only spending quality time with her husband.", "start": 128.333, "duration": 3.712, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=128"}, {"text": "Her story shows us that we can't be fully healthy,", "start": 132.045, "duration": 4.379, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=132"}, {"text": "we can\u2019t thrive, if we take care of our bodies and our minds,", "start": 136.466, "duration": 4.004, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=136"}, {"text": "but not our relationships.", "start": 140.47, "duration": 1.835, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=140"}, {"text": "Similar to Maya,", "start": 143.723, "duration": 1.585, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=143"}, {"text": "hundreds of millions of people around the world go weeks at a time", "start": 145.308, "duration": 4.088, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=145"}, {"text": "without talking to a single friend or family member.", "start": 149.396, "duration": 3.753, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=149"}, {"text": "Globally, one in four people feel lonely.", "start": 154.275, "duration": 3.462, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=154"}, {"text": "And 20 percent of adults worldwide don't feel like they have anyone", "start": 158.488, "duration": 4.046, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=158"}, {"text": "they can reach out to for support.", "start": 162.575, "duration": 2.044, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=162"}, {"text": "Think about that.", "start": 165.245, "duration": 1.168, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=165"}, {"text": "One in five people you encounter may feel like they have no one.", "start": 166.746, "duration": 4.171, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=166"}, {"text": "This is more than heartbreaking.", "start": 172.377, "duration": 2.544, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=172"}, {"text": "It's also a public health crisis.", "start": 174.963, "duration": 2.252, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=174"}, {"text": "Disconnection triggers stress in the body.", "start": 177.549, "duration": 2.627, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=177"}, {"text": "It weakens people's immune systems.", "start": 180.218, "duration": 2.669, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=180"}, {"text": "It puts them at a risk, greater risk, of stroke, heart disease, diabetes,", "start": 182.929, "duration": 5.13, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=182"}, {"text": "dementia, depression and early death.", "start": 188.059, "duration": 3.087, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=188"}, {"text": "Social health is essential for longevity.", "start": 191.646, "duration": 2.961, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=191"}, {"text": "So you might be wondering,", "start": 196.025, "duration": 1.377, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=196"}, {"text": "what does it look like to be socially healthy?", "start": 197.444, "duration": 2.419, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=197"}, {"text": "What does that even mean?", "start": 199.863, "duration": 1.376, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=199"}, {"text": "Well it\u2019s about developing close relationships", "start": 201.531, "duration": 2.92, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=201"}, {"text": "with your family, your friends, your partner, yourself.", "start": 204.451, "duration": 3.628, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=204"}, {"text": "It's about having regular interaction with your coworkers, your neighbors.", "start": 208.58, "duration": 4.337, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=208"}, {"text": "It's about feeling like you belong to a community.", "start": 212.917, "duration": 2.586, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=212"}, {"text": "Being socially healthy is about having the right quantity", "start": 216.254, "duration": 3.837, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=216"}, {"text": "and quality of connection for you.", "start": 220.133, "duration": 2.461, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=220"}, {"text": "And Maya's story is one example", "start": 223.845, "duration": 1.793, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=223"}, {"text": "of how social health challenges come up.", "start": 225.68, "duration": 2.503, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=225"}, {"text": "In my work, I hear many others.", "start": 228.224, "duration": 2.336, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=228"}, {"text": "Stories like Jay,", "start": 230.602, "duration": 1.418, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=230"}, {"text": "a freshman in college", "start": 232.061, "duration": 1.377, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=232"}, {"text": "who\u2019s eager to get involved in campus", "start": 233.48, "duration": 2.669, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=233"}, {"text": "yet is having a hard time fitting in with people in his dorm", "start": 236.149, "duration": 2.836, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=236"}, {"text": "and often feels homesick.", "start": 239.027, "duration": 1.585, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=239"}, {"text": "Or Serena and Ali, a couple juggling the chaos of young kids", "start": 241.154, "duration": 3.837, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=241"}, {"text": "with demanding jobs,", "start": 245.033, "duration": 1.543, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=245"}, {"text": "they rarely have time to see friends", "start": 246.618, "duration": 1.793, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=246"}, {"text": "or spend time one-on-one.", "start": 248.411, "duration": 1.794, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=248"}, {"text": "Or Henry, recently retired,", "start": 250.997, "duration": 2.127, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=250"}, {"text": "who cherishes time with his spouse", "start": 253.166, "duration": 2.294, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=253"}, {"text": "and yet feels untethered without his team anymore", "start": 255.46, "duration": 3.503, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=255"}, {"text": "and wishes he could see his kids and grandkids more often.", "start": 258.963, "duration": 3.045, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=258"}, {"text": "These stories show that social health is relevant to each of us", "start": 262.467, "duration": 4.713, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=262"}, {"text": "at every life stage.", "start": 267.222, "duration": 1.918, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=267"}, {"text": "So if you're not sure where to start,", "start": 269.766, "duration": 1.96, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=269"}, {"text": "try the 5-3-1 guideline from my book.", "start": 271.726, "duration": 2.795, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=271"}, {"text": "It goes like this.", "start": 274.562, "duration": 1.293, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=274"}, {"text": "Aim to interact with five different people each week,", "start": 275.897, "duration": 3.545, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=275"}, {"text": "to strengthen at least three close relationships overall,", "start": 279.484, "duration": 4.004, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=279"}, {"text": "and to spend one hour a day connecting.", "start": 283.53, "duration": 2.919, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=283"}, {"text": "Let's dig into these.", "start": 286.449, "duration": 1.377, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=286"}, {"text": "So first, interact with five different people each week.", "start": 288.201, "duration": 3.837, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=288"}, {"text": "Just like eating a variety of vegetables", "start": 292.08, "duration": 2.377, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=292"}, {"text": "and other food groups is more nutritious,", "start": 294.499, "duration": 2.586, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=294"}, {"text": "research has shown that interacting with a variety of people", "start": 297.085, "duration": 3.462, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=297"}, {"text": "is more rewarding.", "start": 300.547, "duration": 1.293, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=300"}, {"text": "So your five could include close loved ones, casual acquaintances,", "start": 301.881, "duration": 3.963, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=301"}, {"text": "even complete strangers.", "start": 305.844, "duration": 1.251, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=305"}, {"text": "In fact, in one study that I love,", "start": 307.136, "duration": 2.211, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=307"}, {"text": "people who just smiled, made eye contact", "start": 309.347, "duration": 2.419, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=309"}, {"text": "and chit-chatted with a barista,", "start": 311.766, "duration": 1.96, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=311"}, {"text": "felt happier and a greater sense of belonging", "start": 313.726, "duration": 2.67, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=313"}, {"text": "than people who just rushed to get their coffee and go.", "start": 316.437, "duration": 2.878, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=316"}, {"text": "Next, strengthen at least three close relationships.", "start": 320.066, "duration": 3.712, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=320"}, {"text": "OK, we've all heard of a to-do list,", "start": 324.237, "duration": 2.377, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=324"}, {"text": "but I would like to invite you to write a to-love list.", "start": 326.656, "duration": 3.754, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=326"}, {"text": "Who matters most to you?", "start": 331.327, "duration": 1.835, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=331"}, {"text": "Who can you be yourself with?", "start": 333.204, "duration": 2.086, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=333"}, {"text": "Make sure that you invest", "start": 335.331, "duration": 1.71, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=335"}, {"text": "in the names of at least three of the people that you write down.", "start": 337.041, "duration": 3.587, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=337"}, {"text": "By scheduling regular time together,", "start": 340.67, "duration": 2.127, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=340"}, {"text": "by showing a genuine interest in their lives,", "start": 342.797, "duration": 2.711, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=342"}, {"text": "and also by opening up", "start": 345.55, "duration": 1.335, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=345"}, {"text": "about the experiences that you're going through.", "start": 346.926, "duration": 2.336, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=346"}, {"text": "And I'm often asked, does it have to be in person?", "start": 349.637, "duration": 2.544, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=349"}, {"text": "Does texting count?", "start": 352.223, "duration": 1.502, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=352"}, {"text": "Studies have shown that face-to-face is ideal,", "start": 354.309, "duration": 2.419, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=354"}, {"text": "so do that whenever possible.", "start": 356.769, "duration": 1.544, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=356"}, {"text": "But there are absolutely still benefits to staying connected virtually.", "start": 358.313, "duration": 3.795, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=358"}, {"text": "And last, spend one hour a day on meaningful connection.", "start": 362.901, "duration": 4.587, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=362"}, {"text": "OK, if you're an introvert, right now you're probably thinking", "start": 367.488, "duration": 3.254, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=367"}, {"text": "one hour sounds like a lot.", "start": 370.742, "duration": 2.294, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=370"}, {"text": "I get it.", "start": 373.494, "duration": 1.21, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=373"}, {"text": "It might be surprising, but I'm actually also an introvert.", "start": 374.704, "duration": 3.295, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=374"}, {"text": "However, keep in mind that just like getting eight hours of sleep at night,", "start": 378.791, "duration": 4.046, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=378"}, {"text": "the exact amount that's right for you personally", "start": 382.879, "duration": 2.711, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=382"}, {"text": "might be higher or lower.", "start": 385.59, "duration": 1.71, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=385"}, {"text": "But if you are thinking that one hour a day sounds like way too much", "start": 388.259, "duration": 3.754, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=388"}, {"text": "because you're just way too busy,", "start": 392.055, "duration": 1.96, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=392"}, {"text": "I challenge you.", "start": 394.015, "duration": 1.293, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=394"}, {"text": "Adults in the US spend an average of 4.5 hours", "start": 395.85, "duration": 3.003, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=395"}, {"text": "each day on their smartphones.", "start": 398.895, "duration": 2.002, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=398"}, {"text": "So instead of scrolling on social media,", "start": 401.356, "duration": 2.502, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=401"}, {"text": "text a friend.", "start": 403.858, "duration": 1.543, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=403"}, {"text": "Instead of reading news headlines, write a thank-you card.", "start": 405.944, "duration": 3.712, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=405"}, {"text": "Instead of listening to a podcast, call a family member.", "start": 410.323, "duration": 3.295, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=410"}, {"text": "Maya put this into practice", "start": 414.953, "duration": 1.668, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=414"}, {"text": "by scheduling recurring hangouts with a new local friend that she made,", "start": 416.663, "duration": 4.337, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=416"}, {"text": "by attending community events", "start": 421.042, "duration": 3.337, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=421"}, {"text": "and dropping cards off in her neighbors mailboxes,", "start": 424.42, "duration": 3.212, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=424"}, {"text": "by planning trips to see family", "start": 427.674, "duration": 1.543, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=427"}, {"text": "and inviting friends in other cities to come visit.", "start": 429.258, "duration": 2.795, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=429"}, {"text": "And bolstering her social health", "start": 432.095, "duration": 3.253, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=432"}, {"text": "made more of a difference", "start": 435.348, "duration": 1.293, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=435"}, {"text": "than focusing solely on her physical and mental health ever could.", "start": 436.683, "duration": 4.504, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=436"}, {"text": "And I know this because Maya", "start": 441.646, "duration": 3.462, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=441"}, {"text": "is actually me.", "start": 445.149, "duration": 1.335, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=445"}, {"text": "I am so passionate about sharing tools to be socially healthy", "start": 448.82, "duration": 3.712, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=448"}, {"text": "because honestly, I need them too.", "start": 452.532, "duration": 1.877, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=452"}, {"text": "And the 5-3-1 guideline is one way that we can be proactive", "start": 454.701, "duration": 4.045, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=454"}, {"text": "and intentional about our relationships.", "start": 458.788, "duration": 2.878, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=458"}, {"text": "And that is really the point.", "start": 461.708, "duration": 1.626, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=461"}, {"text": "Be proactive and intentional about your social health.", "start": 463.376, "duration": 3.795, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=463"}, {"text": "So zooming out beyond the steps that you and I take individually,", "start": 468.548, "duration": 5.13, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=468"}, {"text": "together, we need to shape a society that thrives through social health.", "start": 473.678, "duration": 3.962, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=473"}, {"text": "Over the next decade,", "start": 478.099, "duration": 1.168, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=478"}, {"text": "I envision educators championing social health in schools.", "start": 479.308, "duration": 3.963, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=479"}, {"text": "And just like kids build their physical muscles in gym class,", "start": 483.271, "duration": 3.67, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=483"}, {"text": "they'll exercise their social muscles in connection class.", "start": 486.941, "duration": 3.587, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=486"}, {"text": "Over the next decade,", "start": 491.237, "duration": 1.126, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=491"}, {"text": "I see our cities and neighborhoods", "start": 492.405, "duration": 2.502, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=492"}, {"text": "being designed with social health in mind,", "start": 494.907, "duration": 2.67, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=494"}, {"text": "where vibrant gathering places foster unity", "start": 497.577, "duration": 2.794, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=497"}, {"text": "and community builders are empowered to bring them to life.", "start": 500.413, "duration": 3.295, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=500"}, {"text": "Over the next decade,", "start": 504.709, "duration": 1.168, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=504"}, {"text": "I believe that social health", "start": 505.918, "duration": 1.669, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=505"}, {"text": "will become as ingrained in our collective consciousness", "start": 507.628, "duration": 3.671, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=507"}, {"text": "as mental health is today.", "start": 511.34, "duration": 2.002, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=511"}, {"text": "Because not that long ago,", "start": 513.384, "duration": 1.251, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=513"}, {"text": "mental health was a taboo topic shrouded in stigma.", "start": 514.635, "duration": 3.712, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=514"}, {"text": "And now public figures talk openly about it,", "start": 518.347, "duration": 2.67, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=518"}, {"text": "there's an entire industry to support it,", "start": 521.059, "duration": 3.128, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=521"}, {"text": "and more and more people think of going to therapy", "start": 524.228, "duration": 2.419, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=524"}, {"text": "like going to the gym.", "start": 526.689, "duration": 1.293, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=526"}, {"text": "In this future, loneliness will subside,", "start": 529.192, "duration": 3.295, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=529"}, {"text": "just like smoking subsided when we recognized", "start": 532.528, "duration": 2.503, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=532"}, {"text": "and treated it as a public health issue.", "start": 535.073, "duration": 2.419, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=535"}, {"text": "In this future,", "start": 538.493, "duration": 1.501, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=538"}, {"text": "I hope that social health will become so deeply woven", "start": 540.036, "duration": 3.67, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=540"}, {"text": "into the fabric of our culture", "start": 543.748, "duration": 1.835, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=543"}, {"text": "that no one needs the 5-3-1 guideline anymore.", "start": 545.625, "duration": 2.961, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=545"}, {"text": "So to get there,", "start": 549.837, "duration": 2.002, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=549"}, {"text": "make relationships your priority not only for you,", "start": 551.881, "duration": 4.004, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=551"}, {"text": "but also for the people you love.", "start": 555.885, "duration": 2.002, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=555"}, {"text": "Because the beauty of nurturing your own social health", "start": 557.929, "duration": 3.67, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=557"}, {"text": "is that it naturally enriches the social health", "start": 561.599, "duration": 2.461, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=561"}, {"text": "of everyone you connect with.", "start": 564.102, "duration": 1.918, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=564"}, {"text": "Thank you.", "start": 566.854, "duration": 1.168, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=566"}, {"text": "", "start": 568.022, "duration": 6.924, "video_id": "LpSDuDIaBGk", "url": "https://youtube.com/watch?v=LpSDuDIaBGk&t=568"}]
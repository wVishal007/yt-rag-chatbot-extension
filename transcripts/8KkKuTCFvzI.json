[{"text": "What keeps us healthy and happy", "start": 12.756, "duration": 3.0, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=12"}, {"text": "as we go through life?", "start": 15.756, "duration": 1.583, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=15"}, {"text": "If you were going to invest now", "start": 18.506, "duration": 2.5, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=18"}, {"text": "in your future best self,", "start": 21.048, "duration": 2.041, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=21"}, {"text": "where would you put your time and your energy?", "start": 23.131, "duration": 2.958, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=23"}, {"text": "There was a recent survey of millennials", "start": 27.131, "duration": 2.417, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=27"}, {"text": "asking them what their most important life goals were,", "start": 29.548, "duration": 5.208, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=29"}, {"text": "and over 80 percent said", "start": 34.756, "duration": 2.042, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=34"}, {"text": "that a major life goal for them was to get rich.", "start": 36.798, "duration": 4.125, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=36"}, {"text": "And another 50 percent of those same young adults", "start": 40.964, "duration": 4.333, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=40"}, {"text": "said that another major life goal", "start": 45.339, "duration": 2.542, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=45"}, {"text": "was to become famous.", "start": 47.881, "duration": 1.833, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=47"}, {"text": "", "start": 50.964, "duration": 1.208, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=50"}, {"text": "And we're constantly told to lean in to work, to push harder", "start": 52.214, "duration": 6.667, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=52"}, {"text": "and achieve more.", "start": 58.881, "duration": 2.041, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=58"}, {"text": "We're given the impression that these are the things that we need to go after", "start": 60.964, "duration": 3.667, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=60"}, {"text": "in order to have a good life.", "start": 64.631, "duration": 1.833, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=64"}, {"text": "Pictures of entire lives,", "start": 66.506, "duration": 2.208, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=66"}, {"text": "of the choices that people make and how those choices work out for them,", "start": 68.714, "duration": 5.208, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=68"}, {"text": "those pictures are almost impossible to get.", "start": 73.964, "duration": 2.875, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=73"}, {"text": "Most of what we know about human life", "start": 78.089, "duration": 3.042, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=78"}, {"text": "we know from asking people to remember the past,", "start": 81.173, "duration": 3.458, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=81"}, {"text": "and as we know, hindsight is anything but 20/20.", "start": 84.631, "duration": 4.792, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=84"}, {"text": "We forget vast amounts of what happens to us in life,", "start": 89.464, "duration": 3.667, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=89"}, {"text": "and sometimes memory is downright creative.", "start": 93.173, "duration": 2.875, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=93"}, {"text": "But what if we could watch entire lives", "start": 96.798, "duration": 4.375, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=96"}, {"text": "as they unfold through time?", "start": 101.214, "duration": 2.834, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=101"}, {"text": "What if we could study people from the time that they were teenagers", "start": 104.089, "duration": 3.959, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=104"}, {"text": "all the way into old age", "start": 108.089, "duration": 2.75, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=108"}, {"text": "to see what really keeps people happy and healthy?", "start": 110.839, "duration": 3.375, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=110"}, {"text": "We did that.", "start": 115.548, "duration": 1.208, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=115"}, {"text": "The Harvard Study of Adult Development", "start": 117.631, "duration": 2.25, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=117"}, {"text": "may be the longest study of adult life that's ever been done.", "start": 119.881, "duration": 4.75, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=119"}, {"text": "For 75 years, we've tracked the lives of 724 men,", "start": 125.714, "duration": 6.125, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=125"}, {"text": "year after year, asking about their work, their home lives, their health,", "start": 133.381, "duration": 4.5, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=133"}, {"text": "and of course asking all along the way without knowing how their life stories", "start": 137.881, "duration": 4.375, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=137"}, {"text": "were going to turn out.", "start": 142.298, "duration": 1.416, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=142"}, {"text": "Studies like this are exceedingly rare.", "start": 145.298, "duration": 3.625, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=145"}, {"text": "Almost all projects of this kind fall apart within a decade", "start": 148.923, "duration": 4.041, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=148"}, {"text": "because too many people drop out of the study,", "start": 153.006, "duration": 3.167, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=153"}, {"text": "or funding for the research dries up,", "start": 156.214, "duration": 2.875, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=156"}, {"text": "or the researchers get distracted,", "start": 159.131, "duration": 2.25, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=159"}, {"text": "or they die, and nobody moves the ball further down the field.", "start": 161.423, "duration": 4.083, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=161"}, {"text": "But through a combination of luck", "start": 166.298, "duration": 2.25, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=166"}, {"text": "and the persistence of several generations of researchers,", "start": 168.548, "duration": 3.708, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=168"}, {"text": "this study has survived.", "start": 172.298, "duration": 1.541, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=172"}, {"text": "About 60 of our original 724 men", "start": 174.506, "duration": 4.5, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=174"}, {"text": "are still alive,", "start": 179.048, "duration": 1.291, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=179"}, {"text": "still participating in the study,", "start": 180.381, "duration": 2.167, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=180"}, {"text": "most of them in their 90s.", "start": 182.548, "duration": 2.041, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=182"}, {"text": "And we are now beginning to study", "start": 185.548, "duration": 1.916, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=185"}, {"text": "the more than 2,000 children of these men.", "start": 187.506, "duration": 3.333, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=187"}, {"text": "And I'm the fourth director of the study.", "start": 191.673, "duration": 2.333, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=191"}, {"text": "Since 1938, we've tracked the lives of two groups of men.", "start": 195.423, "duration": 4.708, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=195"}, {"text": "The first group started in the study", "start": 200.173, "duration": 2.125, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=200"}, {"text": "when they were sophomores at Harvard College.", "start": 202.339, "duration": 2.667, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=202"}, {"text": "They all finished college during World War II,", "start": 205.048, "duration": 2.833, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=205"}, {"text": "and then most went off to serve in the war.", "start": 207.881, "duration": 2.458, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=207"}, {"text": "And the second group that we've followed", "start": 211.298, "duration": 2.125, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=211"}, {"text": "was a group of boys from Boston's poorest neighborhoods,", "start": 213.464, "duration": 4.167, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=213"}, {"text": "boys who were chosen for the study", "start": 217.631, "duration": 2.042, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=217"}, {"text": "specifically because they were from some of the most troubled", "start": 219.673, "duration": 3.333, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=219"}, {"text": "and disadvantaged families", "start": 223.048, "duration": 1.875, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=223"}, {"text": "in the Boston of the 1930s.", "start": 224.923, "duration": 2.75, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=224"}, {"text": "Most lived in tenements, many without hot and cold running water.", "start": 227.673, "duration": 4.625, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=227"}, {"text": "When they entered the study,", "start": 234.506, "duration": 1.917, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=234"}, {"text": "all of these teenagers were interviewed.", "start": 236.464, "duration": 2.917, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=236"}, {"text": "They were given medical exams.", "start": 239.423, "duration": 2.208, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=239"}, {"text": "We went to their homes and we interviewed their parents.", "start": 241.631, "duration": 3.542, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=241"}, {"text": "And then these teenagers grew up into adults", "start": 245.214, "duration": 2.375, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=245"}, {"text": "who entered all walks of life.", "start": 247.589, "duration": 2.417, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=247"}, {"text": "They became factory workers and lawyers and bricklayers and doctors,", "start": 250.048, "duration": 6.083, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=250"}, {"text": "one President of the United States.", "start": 256.173, "duration": 2.333, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=256"}, {"text": "Some developed alcoholism. A few developed schizophrenia.", "start": 260.173, "duration": 4.25, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=260"}, {"text": "Some climbed the social ladder", "start": 265.339, "duration": 2.292, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=265"}, {"text": "from the bottom all the way to the very top,", "start": 267.631, "duration": 3.25, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=267"}, {"text": "and some made that journey in the opposite direction.", "start": 270.881, "duration": 3.292, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=270"}, {"text": "The founders of this study", "start": 275.506, "duration": 2.958, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=275"}, {"text": "would never in their wildest dreams", "start": 278.506, "duration": 2.0, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=278"}, {"text": "have imagined that I would be standing here today, 75 years later,", "start": 280.506, "duration": 4.542, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=280"}, {"text": "telling you that the study still continues.", "start": 285.089, "duration": 3.084, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=285"}, {"text": "Every two years, our patient and dedicated research staff", "start": 289.298, "duration": 3.625, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=289"}, {"text": "calls up our men and asks them if we can send them", "start": 292.923, "duration": 3.041, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=292"}, {"text": "yet one more set of questions about their lives.", "start": 296.006, "duration": 3.125, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=296"}, {"text": "Many of the inner city Boston men ask us,", "start": 300.048, "duration": 3.583, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=300"}, {"text": "\"Why do you keep wanting to study me? My life just isn't that interesting.\"", "start": 303.631, "duration": 3.875, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=303"}, {"text": "The Harvard men never ask that question.", "start": 308.589, "duration": 2.375, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=308"}, {"text": "", "start": 311.006, "duration": 5.208, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=311"}, {"text": "To get the clearest picture of these lives,", "start": 320.923, "duration": 2.875, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=320"}, {"text": "we don't just send them questionnaires.", "start": 323.798, "duration": 2.958, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=323"}, {"text": "We interview them in their living rooms.", "start": 326.756, "duration": 2.458, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=326"}, {"text": "We get their medical records from their doctors.", "start": 329.256, "duration": 2.917, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=329"}, {"text": "We draw their blood, we scan their brains,", "start": 332.214, "duration": 2.5, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=332"}, {"text": "we talk to their children.", "start": 334.714, "duration": 1.709, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=334"}, {"text": "We videotape them talking with their wives about their deepest concerns.", "start": 336.464, "duration": 5.25, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=336"}, {"text": "And when, about a decade ago, we finally asked the wives", "start": 341.714, "duration": 3.542, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=341"}, {"text": "if they would join us as members of the study,", "start": 345.298, "duration": 2.375, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=345"}, {"text": "many of the women said, \"You know, it's about time.\"", "start": 347.673, "duration": 2.708, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=347"}, {"text": "", "start": 350.423, "duration": 1.041, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=350"}, {"text": "So what have we learned?", "start": 351.506, "duration": 1.667, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=351"}, {"text": "What are the lessons that come from the tens of thousands of pages", "start": 353.214, "duration": 5.209, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=353"}, {"text": "of information that we've generated", "start": 358.464, "duration": 3.042, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=358"}, {"text": "on these lives?", "start": 361.506, "duration": 1.208, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=361"}, {"text": "Well, the lessons aren't about wealth or fame or working harder and harder.", "start": 363.714, "duration": 5.625, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=363"}, {"text": "The clearest message that we get from this 75-year study is this:", "start": 370.506, "duration": 6.333, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=370"}, {"text": "Good relationships keep us happier and healthier. Period.", "start": 376.839, "duration": 5.209, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=376"}, {"text": "We've learned three big lessons about relationships.", "start": 383.006, "duration": 3.833, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=383"}, {"text": "The first is that social connections are really good for us,", "start": 386.839, "duration": 4.084, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=386"}, {"text": "and that loneliness kills.", "start": 390.964, "duration": 2.5, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=390"}, {"text": "It turns out that people who are more socially connected", "start": 393.506, "duration": 3.625, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=393"}, {"text": "to family, to friends, to community,", "start": 397.173, "duration": 3.083, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=397"}, {"text": "are happier, they're physically healthier, and they live longer", "start": 400.298, "duration": 4.666, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=400"}, {"text": "than people who are less well connected.", "start": 405.006, "duration": 3.375, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=405"}, {"text": "And the experience of loneliness turns out to be toxic.", "start": 408.423, "duration": 3.416, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=408"}, {"text": "People who are more isolated than they want to be from others", "start": 411.839, "duration": 5.125, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=411"}, {"text": "find that they are less happy,", "start": 417.006, "duration": 3.208, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=417"}, {"text": "their health declines earlier in midlife,", "start": 420.256, "duration": 2.917, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=420"}, {"text": "their brain functioning declines sooner", "start": 423.214, "duration": 2.209, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=423"}, {"text": "and they live shorter lives than people who are not lonely.", "start": 425.464, "duration": 3.542, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=425"}, {"text": "And the sad fact is that at any given time,", "start": 430.048, "duration": 3.208, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=430"}, {"text": "more than one in five Americans will report that they're lonely.", "start": 433.298, "duration": 4.583, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=433"}, {"text": "And we know that you can be lonely in a crowd", "start": 439.048, "duration": 2.666, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=439"}, {"text": "and you can be lonely in a marriage,", "start": 441.714, "duration": 2.667, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=441"}, {"text": "so the second big lesson that we learned", "start": 444.423, "duration": 2.125, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=444"}, {"text": "is that it's not just the number of friends you have,", "start": 446.548, "duration": 3.125, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=446"}, {"text": "and it's not whether or not you're in a committed relationship,", "start": 449.673, "duration": 3.5, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=449"}, {"text": "but it's the quality of your close relationships that matters.", "start": 453.214, "duration": 4.625, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=453"}, {"text": "It turns out that living in the midst of conflict is really bad for our health.", "start": 458.548, "duration": 4.791, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=458"}, {"text": "High-conflict marriages, for example, without much affection,", "start": 463.381, "duration": 3.958, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=463"}, {"text": "turn out to be very bad for our health, perhaps worse than getting divorced.", "start": 467.381, "duration": 5.75, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=467"}, {"text": "And living in the midst of good, warm relationships is protective.", "start": 473.173, "duration": 4.75, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=473"}, {"text": "Once we had followed our men all the way into their 80s,", "start": 477.964, "duration": 3.084, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=477"}, {"text": "we wanted to look back at them at midlife", "start": 481.089, "duration": 3.0, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=481"}, {"text": "and to see if we could predict", "start": 484.131, "duration": 1.583, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=484"}, {"text": "who was going to grow into a happy, healthy octogenarian", "start": 485.714, "duration": 4.0, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=485"}, {"text": "and who wasn't.", "start": 489.714, "duration": 1.209, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=489"}, {"text": "And when we gathered together everything we knew about them", "start": 491.673, "duration": 4.25, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=491"}, {"text": "at age 50,", "start": 495.923, "duration": 1.375, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=495"}, {"text": "it wasn't their middle age cholesterol levels", "start": 498.089, "duration": 2.542, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=498"}, {"text": "that predicted how they were going to grow old.", "start": 500.631, "duration": 2.917, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=500"}, {"text": "It was how satisfied they were in their relationships.", "start": 503.548, "duration": 3.458, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=503"}, {"text": "The people who were the most satisfied in their relationships at age 50", "start": 507.048, "duration": 4.875, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=507"}, {"text": "were the healthiest at age 80.", "start": 511.964, "duration": 2.417, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=511"}, {"text": "And good, close relationships seem to buffer us", "start": 515.673, "duration": 3.208, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=515"}, {"text": "from some of the slings and arrows of getting old.", "start": 518.881, "duration": 2.75, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=518"}, {"text": "Our most happily partnered men and women", "start": 522.506, "duration": 3.958, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=522"}, {"text": "reported, in their 80s,", "start": 526.506, "duration": 2.041, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=526"}, {"text": "that on the days when they had more physical pain,", "start": 528.547, "duration": 2.959, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=528"}, {"text": "their mood stayed just as happy.", "start": 531.506, "duration": 2.0, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=531"}, {"text": "But the people who were in unhappy relationships,", "start": 534.422, "duration": 3.25, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=534"}, {"text": "on the days when they reported more physical pain,", "start": 537.672, "duration": 2.959, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=537"}, {"text": "it was magnified by more emotional pain.", "start": 540.631, "duration": 3.041, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=540"}, {"text": "And the third big lesson that we learned about relationships and our health", "start": 544.381, "duration": 4.375, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=544"}, {"text": "is that good relationships don't just protect our bodies,", "start": 548.756, "duration": 3.25, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=548"}, {"text": "they protect our brains.", "start": 552.047, "duration": 1.459, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=552"}, {"text": "It turns out that being in a securely attached relationship", "start": 554.464, "duration": 4.625, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=554"}, {"text": "to another person in your 80s is protective,", "start": 559.131, "duration": 3.875, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=559"}, {"text": "that the people who are in relationships", "start": 563.047, "duration": 1.959, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=563"}, {"text": "where they really feel they can count on the other person in times of need,", "start": 565.047, "duration": 4.125, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=565"}, {"text": "those people's memories stay sharper longer.", "start": 569.214, "duration": 3.708, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=569"}, {"text": "And the people in relationships", "start": 572.922, "duration": 1.5, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=572"}, {"text": "where they feel they really can't count on the other one,", "start": 574.464, "duration": 3.125, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=574"}, {"text": "those are the people who experience earlier memory decline.", "start": 577.589, "duration": 3.917, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=577"}, {"text": "And those good relationships, they don't have to be smooth all the time.", "start": 582.506, "duration": 3.458, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=582"}, {"text": "Some of our octogenarian couples could bicker with each other", "start": 586.006, "duration": 3.583, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=586"}, {"text": "day in and day out,", "start": 589.589, "duration": 1.75, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=589"}, {"text": "but as long as they felt that they could really count on the other", "start": 591.381, "duration": 3.166, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=591"}, {"text": "when the going got tough,", "start": 594.547, "duration": 1.834, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=594"}, {"text": "those arguments didn't take a toll on their memories.", "start": 596.422, "duration": 3.584, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=596"}, {"text": "So this message,", "start": 601.589, "duration": 2.75, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=601"}, {"text": "that good, close relationships are good for our health and well-being,", "start": 604.381, "duration": 5.666, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=604"}, {"text": "this is wisdom that's as old as the hills.", "start": 610.089, "duration": 2.917, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=610"}, {"text": "Why is this so hard to get and so easy to ignore?", "start": 613.047, "duration": 3.834, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=613"}, {"text": "Well, we're human.", "start": 617.547, "duration": 1.459, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=617"}, {"text": "What we'd really like is a quick fix,", "start": 619.047, "duration": 2.834, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=619"}, {"text": "something we can get", "start": 621.881, "duration": 1.708, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=621"}, {"text": "that'll make our lives good and keep them that way.", "start": 623.589, "duration": 2.792, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=623"}, {"text": "Relationships are messy and they're complicated", "start": 627.339, "duration": 3.333, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=627"}, {"text": "and the hard work of tending to family and friends,", "start": 630.672, "duration": 3.834, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=630"}, {"text": "it's not sexy or glamorous.", "start": 634.506, "duration": 2.666, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=634"}, {"text": "It's also lifelong. It never ends.", "start": 637.214, "duration": 3.333, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=637"}, {"text": "The people in our 75-year study who were the happiest in retirement", "start": 640.547, "duration": 5.084, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=640"}, {"text": "were the people who had actively worked to replace workmates with new playmates.", "start": 645.631, "duration": 5.833, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=645"}, {"text": "Just like the millennials in that recent survey,", "start": 651.506, "duration": 2.958, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=651"}, {"text": "many of our men when they were starting out as young adults", "start": 654.506, "duration": 3.583, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=654"}, {"text": "really believed that fame and wealth and high achievement", "start": 658.131, "duration": 4.0, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=658"}, {"text": "were what they needed to go after to have a good life.", "start": 662.172, "duration": 3.917, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=662"}, {"text": "But over and over, over these 75 years, our study has shown", "start": 666.131, "duration": 4.166, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=666"}, {"text": "that the people who fared the best were the people who leaned in to relationships,", "start": 670.339, "duration": 5.625, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=670"}, {"text": "with family, with friends, with community.", "start": 676.006, "duration": 3.25, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=676"}, {"text": "So what about you?", "start": 681.089, "duration": 1.958, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=681"}, {"text": "Let's say you're 25, or you're 40, or you're 60.", "start": 683.089, "duration": 3.75, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=683"}, {"text": "What might leaning in to relationships even look like?", "start": 687.797, "duration": 2.959, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=687"}, {"text": "Well, the possibilities are practically endless.", "start": 691.756, "duration": 3.125, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=691"}, {"text": "It might be something as simple as replacing screen time with people time", "start": 695.589, "duration": 6.125, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=695"}, {"text": "or livening up a stale relationship by doing something new together,", "start": 701.714, "duration": 4.458, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=701"}, {"text": "long walks or date nights,", "start": 706.214, "duration": 2.208, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=706"}, {"text": "or reaching out to that family member who you haven't spoken to in years,", "start": 709.381, "duration": 4.833, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=709"}, {"text": "because those all-too-common family feuds", "start": 714.256, "duration": 3.5, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=714"}, {"text": "take a terrible toll", "start": 717.756, "duration": 2.208, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=717"}, {"text": "on the people who hold the grudges.", "start": 720.006, "duration": 2.083, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=720"}, {"text": "I'd like to close with a quote from Mark Twain.", "start": 724.006, "duration": 3.916, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=724"}, {"text": "More than a century ago,", "start": 729.297, "duration": 2.375, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=729"}, {"text": "he was looking back on his life,", "start": 731.672, "duration": 2.625, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=731"}, {"text": "and he wrote this:", "start": 734.339, "duration": 1.25, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=734"}, {"text": "\"There isn't time, so brief is life,", "start": 736.839, "duration": 3.708, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=736"}, {"text": "for bickerings, apologies, heartburnings, callings to account.", "start": 740.547, "duration": 5.167, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=740"}, {"text": "There is only time for loving,", "start": 746.714, "duration": 2.833, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=746"}, {"text": "and but an instant, so to speak, for that.\"", "start": 749.547, "duration": 3.75, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=749"}, {"text": "The good life is built with good relationships.", "start": 754.756, "duration": 4.375, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=754"}, {"text": "Thank you.", "start": 759.172, "duration": 1.209, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=759"}, {"text": "", "start": 760.422, "duration": 5.417, "video_id": "8KkKuTCFvzI", "url": "https://youtube.com/watch?v=8KkKuTCFvzI&t=760"}]
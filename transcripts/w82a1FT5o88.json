[{"text": "One of the first words you should say in a speech, and what are the last words you should say in a speech", "start": 0.339, "duration": 6.229, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=0"}, {"text": "Now tomorrow, I don't know how many of you are speaking, but I guarantee if you go to conferences", "start": 10.42, "duration": 7.49, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=10"}, {"text": "19 out of 20 speakers will start in one of these ways number one", "start": 19.48, "duration": 4.58, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=19"}, {"text": "My name is Connor Neal. I'm from tango and this talk is about the latest trend in monitoring strategies", "start": 24.82, "duration": 6.44, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=24"}, {"text": "Now all of you are sitting with a piece of paper in front of you. That says I'm Connor Neal", "start": 32.079, "duration": 3.74, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=32"}, {"text": "I've come from Ireland, and I'm going to talk about tango 0-4 and this", "start": 35.89, "duration": 4.7, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=35"}, {"text": "So by repeating what you already know? I'm giving a signal that it's a time to get your BlackBerry out", "start": 41.379, "duration": 5.36, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=41"}, {"text": "I've just signals that this talk is", "start": 47.5, "duration": 2.539, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=47"}, {"text": "Opportunity to reconnect with blackberry make sure the office is ok, maybe get some plans together for the weekend", "start": 51.34, "duration": 6.469, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=51"}, {"text": "Another way to start", "start": 60.67, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=60"}, {"text": "The lights and some of the mics working and how much time have I got", "start": 68.979, "duration": 3.95, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=68"}, {"text": "Ok right", "start": 74.89, "duration": 2.029, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=74"}, {"text": "ok", "start": 78.31, "duration": 1.41, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=78"}, {"text": "Is it is it plugged in?", "start": 79.72, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=79"}, {"text": "and", "start": 81.88, "duration": 1.2, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=81"}, {"text": "You laugh, but I guarantee tomorrow. There's going to be some moments", "start": 83.08, "duration": 3.679, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=83"}, {"text": "They get a little bit up", "start": 88.54, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=88"}, {"text": "And", "start": 91.3, "duration": 1.14, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=91"}, {"text": "Why because this is for some of you the first time you see this individual. They're here as a leader in their industry and", "start": 92.44, "duration": 7.069, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=92"}, {"text": "Your kid at school presenting on giraffes does a better job", "start": 100.63, "duration": 3.05, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=100"}, {"text": "That's sad I", "start": 105.4, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=105"}, {"text": "Think there's only three ways of starting a speech", "start": 110.5, "duration": 2.96, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=110"}, {"text": "And it's the same if you went into a bar", "start": 116.18, "duration": 3.4, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=116"}, {"text": "and there's a group of people as a networking event much like you were at before you walked into this room and", "start": 119.76, "duration": 6.02, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=119"}, {"text": "Maybe I came up to a group", "start": 126.94, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=126"}, {"text": "There's group of three people who are having a little conversation. I walk in and I say hi. I'm Connor", "start": 129.039, "duration": 4.49, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=129"}, {"text": "I'm Irish 38 years old I have an interest in sailing. I like running", "start": 133.53, "duration": 4.139, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=133"}, {"text": "And they've walked away", "start": 140.92, "duration": 2.389, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=140"}, {"text": "How do you get people to engage with you when you're networking I", "start": 145.959, "duration": 3.89, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=145"}, {"text": "Say in networking the best thing you can do is walk up. I think we know someone in common", "start": 153.7, "duration": 4.099, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=153"}, {"text": "Try and walk away when someone comes up and says that to you", "start": 160.0, "duration": 2.66, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=160"}, {"text": "Hopefully, you've done your research, so you do know that you've know someone in common, but with LinkedIn", "start": 165.549, "duration": 3.77, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=165"}, {"text": "You can find out who knows who on anyone you want?", "start": 170.11, "duration": 3.68, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=170"}, {"text": "So how to start a speech?", "start": 174.94, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=174"}, {"text": "first way", "start": 177.519, "duration": 1.621, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=177"}, {"text": "With a question that matters to the audience", "start": 179.14, "duration": 2.509, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=179"}, {"text": "How do you phrase a problem that the audience faces in a question", "start": 183.37, "duration": 5.3, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=183"}, {"text": "So that'd be the third best way of starting a speech", "start": 190.15, "duration": 2.99, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=190"}, {"text": "The second best way of starting a speech with a factoid that shocks", "start": 194.47, "duration": 4.97, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=194"}, {"text": "There's more people alive today than have ever died", "start": 201.43, "duration": 3.86, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=201"}, {"text": "More people alive today than have ever died", "start": 207.73, "duration": 3.65, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=207"}, {"text": "There's a lot of speeches that can follow on from there", "start": 216.71, "duration": 2.209, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=216"}, {"text": "Every two minutes", "start": 221.0, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=221"}, {"text": "The energy reaching the earth from the Sun is", "start": 224.36, "duration": 2.99, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=224"}, {"text": "equivalent to the whole annual usage of humanity", "start": 228.68, "duration": 4.22, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=228"}, {"text": "All the energy all the cars everything moving all the lighting all the air conditioning of the world in", "start": 235.25, "duration": 6.74, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=235"}, {"text": "One year is equivalent to two minutes of Sun", "start": 242.57, "duration": 3.169, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=242"}, {"text": "Does that change how you think about energy", "start": 248.36, "duration": 2.119, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=248"}, {"text": "So what's a fact that shocks the audience into rethinking?", "start": 253.79, "duration": 5.449, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=253"}, {"text": "and", "start": 260.54, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=260"}, {"text": "Google has transformed your ability to get at these facts", "start": 263.36, "duration": 3.17, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=263"}, {"text": "Given two or three minutes you can find out one whether anything I've said is true", "start": 267.71, "duration": 3.17, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=267"}, {"text": "But you trust me because I", "start": 272.54, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=272"}, {"text": "Look the part, and I'm from ESA", "start": 275.66, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=275"}, {"text": "those are in fact two true facts", "start": 278.22, "duration": 3.2, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=278"}, {"text": "I Usually get someone come up to me and are you sure but how do they measure dead and alive", "start": 284.86, "duration": 3.68, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=284"}, {"text": "But it's true, and it's not even close", "start": 290.12, "duration": 2.84, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=290"}, {"text": "But the best way to", "start": 296.5, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=296"}, {"text": "Start a speech and the way that I hope all of you use from now forward", "start": 298.84, "duration": 6.2, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=298"}, {"text": "is the same way", "start": 305.92, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=305"}, {"text": "We start a story to a child", "start": 308.84, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=308"}, {"text": "Now how do we start a story to a child?", "start": 312.71, "duration": 2.69, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=312"}, {"text": "And I say oneth", "start": 317.84, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=317"}, {"text": "once upon a time", "start": 320.12, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=320"}, {"text": "And what happens when you say once upon a time I can tell you what happens when I say once upon a time my daughter", "start": 322.82, "duration": 6.5, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=322"}, {"text": "leans forward", "start": 329.81, "duration": 1.919, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=329"}, {"text": "gets ready to hear", "start": 331.729, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=331"}, {"text": "engages", "start": 334.31, "duration": 1.71, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=334"}, {"text": "and", "start": 336.02, "duration": 1.2, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=336"}, {"text": "We were all trained as kids", "start": 337.22, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=337"}, {"text": "to know when a story's coming", "start": 339.71, "duration": 2.089, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=339"}, {"text": "We also know when a teacher is about to deliver a 40 minute boring lecture that has no impact on our lives", "start": 343.37, "duration": 6.209, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=343"}, {"text": "But in business", "start": 351.15, "duration": 1.71, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=351"}, {"text": "You don't hear him Jack Welsh saying once upon a time", "start": 352.86, "duration": 2.809, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=352"}, {"text": "Steve Jobs doesn't heart start his speeches once upon a time, so there's a grown-up way of saying once upon a time and", "start": 356.46, "duration": 7.76, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=356"}, {"text": "If you listen to the conversations that are interesting around you at a dinner table in", "start": 365.04, "duration": 4.849, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=365"}, {"text": "A networking event if you listen to the people that are gathering the group of eight that are listening to them", "start": 370.23, "duration": 4.97, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=370"}, {"text": "The way they're talking is different the way they start is different", "start": 375.389, "duration": 4.43, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=375"}, {"text": "The way you tell stories as an adult is in", "start": 384.03, "duration": 2.63, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=384"}, {"text": "October was the last time I was in this room there were a hundred and twenty people in the room", "start": 387.54, "duration": 4.339, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=387"}, {"text": "And I was having a little conversation with one of the world experts on public speaking and he said something to me", "start": 391.95, "duration": 6.949, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=391"}, {"text": "He said something to me", "start": 399.45, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=399"}, {"text": "This had me thinking ever since", "start": 401.58, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=401"}, {"text": "He said something to me that changed", "start": 404.49, "duration": 2.149, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=404"}, {"text": "What I think about what's important in speaking?", "start": 407.43, "duration": 3.589, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=407"}, {"text": "Now I can pause for about 30 seconds two or three minutes, and you want to know what he said", "start": 415.45, "duration": 6.14, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=415"}, {"text": "So in", "start": 425.23, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=425"}, {"text": "Speaking in sales, we assume", "start": 427.69, "duration": 2.839, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=427"}, {"text": "self-interest", "start": 431.92, "duration": 1.47, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=431"}, {"text": "So if you can tell a story from your own life that", "start": 433.39, "duration": 2.899, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=433"}, {"text": "Connects you to why this topic is important to you. Why you first joined the company when you first saw someone", "start": 437.02, "duration": 7.489, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=437"}, {"text": "benefit", "start": 445.03, "duration": 1.41, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=445"}, {"text": "And you saw how their life was changed, and I think here", "start": 446.44, "duration": 4.1, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=446"}, {"text": "exploring what quality of life means for you in your business", "start": 451.78, "duration": 6.2, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=451"}, {"text": "How do you affect quality of life for a customer?", "start": 458.44, "duration": 4.19, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=458"}, {"text": "Because that's where the stories that will start to connect you to the audience will come from", "start": 464.95, "duration": 5.149, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=464"}, {"text": "Because stories are about people", "start": 471.85, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=471"}, {"text": "They're not about objects they are not about things. It's about the people behind the things", "start": 476.08, "duration": 4.22, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=476"}, {"text": "If you want to tell a good story about Tango don't talk about the software talk about the people who built the software", "start": 481.15, "duration": 5.239, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=481"}, {"text": "What they do how they are what's important to them what they sacrifice?", "start": 486.64, "duration": 4.789, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=486"}, {"text": "And in your own life", "start": 492.91, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=492"}, {"text": "What does quality of life mean? What sacrifices have you made to achieve something that was more important and", "start": 495.4, "duration": 5.029, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=495"}, {"text": "If you can tell stories and the audience connect with those stories then", "start": 501.13, "duration": 3.83, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=501"}, {"text": "They want to hear what you have to say", "start": 505.63, "duration": 2.0, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=505"}, {"text": "And all the reasons and all the benefits. They're all written in the document and in the PowerPoint", "start": 508.18, "duration": 5.42, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=508"}, {"text": "But they need to trust you", "start": 514.36, "duration": 1.65, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=514"}, {"text": "And they need to care about you as a person to engage with you and then decide that they will act", "start": 516.01, "duration": 5.809, "video_id": "w82a1FT5o88", "url": "https://youtube.com/watch?v=w82a1FT5o88&t=516"}]